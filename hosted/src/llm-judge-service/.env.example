# ローカル実行用（Hosted Agent では azure.yaml の environmentVariables と自動で入る FOUNDRY_* を使う）
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
# 採点に使う Judge のデプロイとモデルバージョン（config.py の既定と同じなら不要）
JUDGE_DEPLOYMENT=gpt-6.1-sol
JUDGE_MODEL_VERSION=2026-09-29
# ローカルは az login の資格情報（Hosted Agent では default = マネージド ID）
LLM_JUDGE_AUTH=cli
# 状態の保存先。未設定ならファイル（LLM_JUDGE_STATE_DIR）
# LLM_JUDGE_STATE_COSMOS_ENDPOINT=https://<account>.documents.azure.com:443/
LLM_JUDGE_STATE_DIR=.state
LLM_JUDGE_RESULTS_DIR=.state/results
# 可視化基盤に送る場合
# LLM_JUDGE_PUBLISH=1
# LLM_JUDGE_COSMOS_ENDPOINT=https://<account>.documents.azure.com:443/
# LLM_JUDGE_APPINSIGHTS_CONNECTION_STRING=InstrumentationKey=...;IngestionEndpoint=...
# 人間レビューをレビュー用リポジトリで受ける場合
# LLM_JUDGE_REVIEW_REPO=<owner>/<name>
# LLM_JUDGE_GITHUB_TOKEN_SECRET_URI=https://<vault>.vault.azure.net/secrets/<name>
