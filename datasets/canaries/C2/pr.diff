diff --git a/app/orders.py b/app/orders.py
--- a/app/orders.py
+++ b/app/orders.py
@@ -1,11 +1,23 @@
 from fastapi import APIRouter, Depends, HTTPException
 
 from app.auth import User, get_current_user
 from app.db import OrderRepository, get_repository
 
 router = APIRouter()
 
 
 @router.get("/orders")
 def list_orders(user: User = Depends(get_current_user), repo: OrderRepository = Depends(get_repository)):
     return repo.list_by_user(user.id)
+
+
+@router.get("/orders/{order_id}")
+def get_order(
+    order_id: int,
+    user: User = Depends(get_current_user),
+    repo: OrderRepository = Depends(get_repository),
+):
+    order = repo.get(order_id)
+    if order is None:
+        raise HTTPException(status_code=404, detail="order not found")
+    return order
diff --git a/tests/test_orders.py b/tests/test_orders.py
--- a/tests/test_orders.py
+++ b/tests/test_orders.py
@@ -18,3 +18,14 @@ def test_list_orders(client, alice):
     res = client.get("/orders", headers=alice.headers)
     assert res.status_code == 200
+
+
+def test_get_order(client, alice, alice_order):
+    res = client.get(f"/orders/{alice_order.id}", headers=alice.headers)
+    assert res.status_code == 200
+    assert res.json()["id"] == alice_order.id
+
+
+def test_get_order_not_found(client, alice):
+    res = client.get("/orders/99999", headers=alice.headers)
+    assert res.status_code == 404
